<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- iOS-inspired deep official government blue vertical gradient -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="54"
                android:endY="108"
                android:startX="54"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF1565C0"
                    android:offset="0.0" />
                <item
                    android:color="#FF0A4DA2"
                    android:offset="0.55" />
                <item
                    android:color="#FF06326E"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle top radial sheen mimicking Apple icon lighting -->
    <path android:pathData="M0,0 L108,0 L108,58 L0,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="12"
                android:gradientRadius="64"
                android:type="radial">
                <item
                    android:color="#26FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
