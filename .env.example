# ==============================================================================
# SuggestBox - Digital Suggestion Box for Local Governance
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SMTP Email Gateway Configuration (Email OTP Authentication)
# ------------------------------------------------------------------------------
# Configure your SMTP provider credentials below.
# Supported providers: Gmail SMTP, Amazon SES, Brevo (Sendinblue), Zoho Mail, Mailgun, etc.

# SMTP Server hostname (e.g., smtp.gmail.com, email-smtp.us-east-1.amazonaws.com, smtp-relay.brevo.com, smtppro.zoho.in)
SMTP_HOST=smtp.gmail.com

# SMTP Server port: 587 (STARTTLS recommended) or 465 (SSL)
SMTP_PORT=587

# SMTP Authentication credentials
SMTP_USERNAME=notifications@suggestbox.gov.in
SMTP_PASSWORD=your-secure-app-password-or-api-key

# Sender Address & Display Name
SMTP_FROM=no-reply@suggestbox.gov.in
SMTP_FROM_NAME=SuggestBox Civic Governance

# Transport Security (true for port 587 STARTTLS / port 465 SSL, false for plaintext local dev)
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# OTP Security Policies
# ------------------------------------------------------------------------------
# Verification Code Expiration (Minutes): Default is 10 minutes
OTP_EXPIRY_MINUTES=10

# Maximum Incorrect Verification Attempts per Code: Default is 5 attempts
OTP_MAX_ATTEMPTS=5

# Resend Cooldown (Seconds): Default is 60 seconds
OTP_RESEND_COOLDOWN_SECONDS=60

# Hourly Request Limit per Email / IP: Default is 5 requests/hour
OTP_MAX_HOURLY_REQUESTS=5

# ------------------------------------------------------------------------------
# Backend & Firebase (Optional - Mock mode active by default)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=suggestbox-gov-in
USE_FIREBASE_EMULATOR=false
